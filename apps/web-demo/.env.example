# 大模型复核（L2）配置。复制本文件并改名为 .env，填写后重新启动 server.py。
# .env 已在 .gitignore 里，不会提交到 git；不要把 Key 写进 .env.example。
# 同名环境变量优先于本文件。不需要大模型复核时可以不建 .env。

# 阿里云百炼：只填这一项即可（默认接口 https://dashscope.aliyuncs.com/compatible-mode/v1，默认模型 qwen3.7-plus）
VLM_API_KEY=

# 换模型（可选）：qwen3.8-max 精度最高，qwen3.8-flash 最便宜
VLM_MODEL=

# 其他 OpenAI 兼容接口（可选），如内网 vLLM：http://10.0.0.8:8001/v1（内网地址自动绕过系统代理）
VLM_BASE_URL=

# 设为 1 时用 JSON Schema 约束输出（vLLM 支持；不支持的服务会自动退回）
VLM_SCHEMA=

# 深度思考（可选，vLLM 部署的 Qwen3 系列）：1 = 全部开启；fingers,nails 这样逗号分隔 = 只对这些检测项开启
# 开启后单次复核从几秒变成十几到几十秒；超时和输出上限默认自动放宽到 600 秒、8192 token
VLM_THINKING=

# 单次请求超时（秒）和输出 token 上限（可选）。默认：不思考 90 / 2048，思考 600 / 8192
VLM_TIMEOUT=
VLM_MAX_TOKENS=

# 每次请求最多几张图（可选，默认 1）：转头视角的左右两张会分两次调用再合并
VLM_IMAGES_PER_REQUEST=

# 服务端判定（L1）用的流水线：configs/pipelines/ 下的名字。默认 auto（先试 rtmw-skin-cpu，不行用 mediapipe-skin）
# RTMW 需要 pip install -e ".[mediapipe,rtmw]"，首次启动从 download.openmmlab.com 下载几百 MB 模型；off = 只用浏览器端结果
LIMBCHECK_PIPELINE=

# 端口（默认 8000）
PORT=
